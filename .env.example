# Generate a long random value before deploying. Required by Payload.
# Do not commit or send this value in chat.
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Neon pooled Postgres connection string. Required for Payload.
# Keep it private; use the Production branch/role URL with sslmode=require.
DATABASE_URI=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# The public app URL, without a trailing slash. Use http://localhost:3000 locally.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Backblaze B2 is all-or-none. Keep all six empty for local filesystem uploads.
# Use a dedicated private bucket per environment; public buckets require payment verification.
# Copy the exact S3 endpoint and region from the bucket details, e.g.
# https://s3.us-west-004.backblazeb2.com and us-west-004.
B2_BUCKET=
B2_ENDPOINT=
B2_REGION=
# Use a manually-created, bucket-restricted application key; the master key is unsupported by S3.
# Grant list/read/write/delete file capabilities and "List All Bucket Names". Keep these secret.
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
# Public Cloudflare media URL, no trailing slash, e.g. https://media.example.com.
# Objects are stored below architecture-website/v1/media/ automatically.
B2_PUBLIC_URL=
