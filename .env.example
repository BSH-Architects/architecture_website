# Generate a long random value before deploying. Required by Payload.
# Do not commit or send this value in chat.
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Neon pooled Postgres connection string. Required for Payload.
# Keep it private; use the Production branch/role URL with sslmode=require.
DATABASE_URI=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# The public app URL, without a trailing slash. Use http://localhost:3000 locally.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudflare R2 is all-or-none. Keep all five empty for local filesystem uploads.
# Use a dedicated bucket per environment, e.g. architecture-website-media-production.
# Endpoint: https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=
R2_ENDPOINT=
# An R2 S3 API token restricted to this bucket with Object Read & Write only.
# Do not commit or send these values in chat.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public custom-domain URL for the bucket, no trailing slash, e.g. https://media.example.com.
# Objects are stored below architecture-website/v1/media/ automatically.
R2_PUBLIC_URL=
