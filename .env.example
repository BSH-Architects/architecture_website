# Generate a long random value before deploying. Required by Payload.
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Neon pooled or direct Postgres connection string. Required for Payload.
DATABASE_URI=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# The deployed URL, without a trailing slash (for example: https://studio.example.com).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudflare R2 is all-or-none. Keep all five empty for local filesystem uploads.
# Example endpoint: https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public custom-domain URL for the bucket, no trailing slash (for example https://media.example.com).
R2_PUBLIC_URL=
