{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bsh-architects-media",
  "main": "src/index.js",
  "compatibility_date": "2026-08-12",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
    "B2_BUCKET": "BSH-Architects-Media",
    "B2_ENDPOINT": "s3.us-east-005.backblazeb2.com",
    "B2_REGION": "us-east-005"
  },
  "observability": {
    "enabled": true
  }
}
